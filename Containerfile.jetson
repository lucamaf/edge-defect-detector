# Jetson/JetPack 6 (L4T R36.x) build with real GPU-accelerated inference.
# Use this instead of Containerfile when building/running directly on the Jetson.
#
# The generic Containerfile pulls plain PyPI torch via requirements.txt, which is built
# for discrete-GPU CUDA and can't talk to the Tegra iGPU on Orin (it silently falls back
# to CPU). This base image already ships a JetPack-matched torch/torchvision/ultralytics/
# opencv build with working CUDA support, so we deliberately do NOT install requirements.txt
# on top of it -- doing so would reinstall generic wheels and undo the GPU support.
FROM docker.io/ultralytics/ultralytics:latest-jetson-jetpack6

# ffmpeg is needed to transcode processed video output to H.264 for browser playback
# (not included in the base image).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Set environment variables with default values.
# These can be overridden at runtime.
ENV MQTT_BROKER="mqtt_broker_address"
ENV MQTT_PORT="1883"
ENV MQTT_TOPIC_CONTROL="defect_detection/control"
ENV MQTT_TOPIC_STATUS="defect_detection/status"
ENV MODEL_PATH="/app/models/best.pt"
ENV FLASK_WEB_PORT="5000"

# Only the app-specific deps -- torch/torchvision/ultralytics/opencv already come
# from the base image, matched to this Jetson's JetPack/CUDA version.
RUN pip install --no-cache-dir flask paho-mqtt dill

# Copy the rest of the application code into the container
COPY . .

EXPOSE 5000

CMD ["python3", "app.py"]
